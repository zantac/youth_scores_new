# Copy to .env.local for local development.
#
# Point the site at the local Flask backend instead of the live static feed.
# Left UNSET in production, where Flask serves this app and /api from the same
# origin (www.youthscores.org).
NEXT_PUBLIC_CONFIG_URL=http://localhost:5001/api/config

# Firebase web push. All public (they ship in the browser bundle, inlined at
# build). Copy from Firebase console -> Project settings -> General (Web app
# config) and Cloud Messaging (Web Push "VAPID" key). Keep in sync with
# public/firebase-messaging-sw.js.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_VAPID_KEY=
