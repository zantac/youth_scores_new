# Loaded automatically by `next build` (production). Committed on purpose so the
# Docker/Railway build — which sets no env vars — still inlines the Firebase web
# config. These are PUBLIC values (they ship in the browser bundle and are
# duplicated in public/firebase-messaging-sw.js); the service-account key is the
# only secret and it stays server-side.
#
# NEXT_PUBLIC_CONFIG_URL is intentionally NOT set here: production serves the app
# and /api from the same origin, so the app's relative default is correct. Local
# dev overrides these via .env.local (which is gitignored and wins over this).
NEXT_PUBLIC_FIREBASE_API_KEY=AIzaSyDzi2sIqqjoRnJ4WHO_NvUK2plmR7oxoos
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=youthscores.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=youthscores
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=youthscores.firebasestorage.app
NEXT_PUBLIC_FIREBASE_SENDER_ID=492562642059
NEXT_PUBLIC_FIREBASE_APP_ID=1:492562642059:web:153bd79e686fd76c31508e
