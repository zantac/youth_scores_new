# Copy to .env.local for local development.
#
# In production this is left UNSET: Flask serves this app and /api/tla3bny from
# the same origin (tla3bny.youthscores.org), so the client uses relative URLs.
# Locally the Next dev server and Flask are on different ports, so point it at
# whichever port you started Flask on.
NEXT_PUBLIC_CONFIG_URL=http://localhost:5001/api/config
