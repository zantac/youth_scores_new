# Copy to .env.local for local development.
#
# In production this is left UNSET: Flask serves this app and /api/tla3bny from
# the same origin (tla3bny.youthscores.org), so the client uses relative URLs.
# Locally the Next dev server and Flask are on different ports, so point it at
# whichever port you started Flask on.
NEXT_PUBLIC_CONFIG_URL=http://localhost:5001/api/config

# Firebase web push (all public — they ship in the browser bundle). Same Firebase
# project as youthscores. Copy from Firebase console; keep in sync with
# public/firebase-messaging-sw.js. Committed real values live in .env.production.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_VAPID_KEY=
